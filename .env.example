# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=
# Caminho para o arquivo de credenciais da conta de serviço do Google
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json

# --- Banco de dados ---
DATABASE_URL=sqlite:///./backend/data/pipoca.db

# --- Admin ---
# Número de telefone da loja que tem acesso a comandos administrativos
# (ex: "relatorio"). Formato igual ao usado pela Cloud API, ex: 5511999999999
ADMIN_PHONE_NUMBER=

# --- Horário de atendimento ---
HORARIO_ABERTURA=08:00
HORARIO_FECHAMENTO=21:00

# --- App ---
APP_SECRET_KEY=
