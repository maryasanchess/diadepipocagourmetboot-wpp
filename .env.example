# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=
# Caminho para o arquivo de credenciais da conta de serviço do Google
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json

# --- Banco de dados ---
DATABASE_URL=sqlite:///./backend/data/pipoca.db

# --- App ---
APP_SECRET_KEY=
