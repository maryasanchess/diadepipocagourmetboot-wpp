# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Google Calendar e Sheets ---
GOOGLE_CALENDAR_ID=
GOOGLE_SHEETS_CARDAPIO_ID=
# Caminho para o arquivo de credenciais da conta de serviço do Google
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json
# Minutos que o cardápio lido da planilha fica em cache antes de reconsultar
CARDAPIO_CACHE_MINUTOS=10

# --- Banco de dados ---
# Deixe comentado/ausente para usar o padrão (backend/data/pipoca.db).
# DATABASE_URL=sqlite:///caminho/absoluto/se/precisar/mudar.db

# --- Admin ---
# Um ou mais números de telefone com acesso a comandos administrativos
# (ex: "relatorio"), separados por vírgula. Pode informar com ou sem o
# código do país (55) — o bot completa automaticamente se faltar.
# Ex: 5511999999999,11988887777
ADMIN_PHONE_NUMBER=

# --- Horário de atendimento ---
HORARIO_ABERTURA=08:00
HORARIO_FECHAMENTO=21:00

# --- Pagamento ---
PIX_CHAVE=chave-pix-a-definir@loja.com

# --- Antecedência mínima para pedidos (loja trabalha por encomenda) ---
ANTECEDENCIA_MINIMA_HORAS=24

# --- Taxa de entrega ---
# Deixe em branco até a loja definir a regra (o bot mostra "a confirmar
# com a loja" pro cliente). Preencha com um valor fixo em reais (ex: 5.00)
# quando a regra for decidida — passa a aparecer automaticamente no
# resumo do pedido e no total. Só serve pra um valor fixo simples; regras
# por bairro/distância exigem código novo (ver docs/01-visao-geral.md).
TAXA_ENTREGA_FIXA=

# --- App ---
APP_SECRET_KEY=
